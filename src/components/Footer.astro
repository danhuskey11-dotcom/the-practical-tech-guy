---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<a class="footer-logo" href="/" aria-label="The Practical Tech Guy home"><img src="/branding/logo-horizontal-dark.png" alt="The Practical Tech Guy"/></a>

		<nav class="footer-links" aria-label="Footer navigation">
	          <a href="/about">About</a>
			  <a href="/contact">Contact</a>
	          <a href="/privacy-policy">Privacy Policy</a>
	          <a href="/affiliate-disclosure">Affiliate Disclosure</a>
        </nav>

		<p class="copyright">
			&copy; {today.getFullYear()} The Practical Tech Guy. All rights reserved.
		</p>
	</div>
</footer>

<style>
	footer {
		margin-top: 3rem;
		padding: 3rem 1.5rem;
		background: var(--navy);
		color: #cbd5e1;
		text-align: center;
	}

	.footer-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 1100px;
		margin: 0 auto;
		gap: 1rem;
	}

.footer-logo {
	display: flex;
	align-items: center;
	justify-content: center;
	text-decoration: none;
}

.footer-logo img {
	display: block;
	width: auto;
	height: 100px;
}

	.footer-links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
	}

	.footer-links a {
		color: #cbd5e1;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-links a:hover {
		color: #5eead4;
		text-decoration: none;
	}

	.copyright {
		margin: 0;
		padding-top: 0.75rem;
		color: #94a3b8;
		font-size: 0.8rem;
		border-top: 1px solid rgba(226, 232, 240, 0.15);
		width: 100%;
	}

	@media (max-width: 720px) {
		footer {
			padding: 2.5rem 1rem;
		}

		.footer-logo img {
			height: 80px;
		}

		.footer-links {
			gap: 0.75rem 1rem;
		}
	}
</style>
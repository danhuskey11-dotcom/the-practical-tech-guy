---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Tech Guides</HeaderLink>
			<HeaderLink href="/reviews">Reviews</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1.5rem;
		background: var(--white);
		border-bottom: 1px solid var(--light-gray);
		box-shadow: 0 2px 8px rgba(15, 39, 68, 0.05);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1100px;
		margin: 0 auto;
		min-height: 72px;
	}

	h2 {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 700;
	}

	h2 a,
	h2 a.active {
		padding: 0;
		color: var(--navy);
		text-decoration: none;
		border-bottom: none;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	nav a {
		padding: 1.35rem 0.75rem;
		color: var(--slate);
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 600;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	nav a:hover {
		color: var(--blue);
	}

	nav a.active {
		color: var(--blue);
		text-decoration: none;
		border-bottom-color: var(--blue);
	}

	@media (max-width: 720px) {
		header {
			padding: 0 1rem;
		}

		nav {
			align-items: flex-start;
			flex-direction: column;
			padding-top: 1rem;
		}

		h2 {
			padding-bottom: 0.5rem;
		}

		.internal-links {
			width: 100%;
			justify-content: space-between;
			gap: 0;
			overflow-x: auto;
		}

		nav a {
			padding: 0.75rem 0.4rem;
			font-size: 0.85rem;
			white-space: nowrap;
		}
	}
</style>

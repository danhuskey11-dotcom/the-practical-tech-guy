---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getCategoryName } from '../data/categories';
import { getReviewCategoryName } from '../data/reviewCategories';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	contentType,
	category,
	reviewCategory,
	tags,
	author,
	affiliate,
} = Astro.props;


const contentTypeNames: Record<string, string> = {
	guide: 'Tech Guide',
	review: 'Review',
	comparison: 'Comparison',
	news: 'News',
};

const categoryName = getCategoryName(category);
const contentTypeName =
	contentTypeNames[contentType] ?? contentType;

const isReview = contentType === 'review';

const sectionName = isReview
	? 'Reviews'
	: 'Tech Guides';

const sectionUrl = isReview
	? '/reviews/'
	: '/guides/';

const displayCategory = isReview && reviewCategory
	? getReviewCategoryName(reviewCategory)
	: getCategoryName(category);

const categoryUrl = isReview && reviewCategory
	? `/reviews/category/${reviewCategory}/`
	: `/guides/category/${category}/`;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
		    .article-header {
	margin-bottom: 2.5rem;
	padding: 2rem 0 2rem;
	border-bottom: 1px solid var(--light-gray);
}

.breadcrumbs {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 0.4rem;
	margin-bottom: 1.5rem;
	font-size: 0.85rem;
}

.breadcrumbs a {
	color: var(--blue);
	font-weight: 600;
	text-decoration: none;
}

.breadcrumbs a:hover {
	text-decoration: underline;
}

.breadcrumbs span {
	color: rgb(var(--gray));
}

.content-type {
	margin: 0 0 0.75rem;
	color: var(--teal);
	font-size: 0.8rem;
	font-weight: 700;
	letter-spacing: 0.12em;
	text-transform: uppercase;
}

.article-header h1 {
	margin-bottom: 1rem;
	color: var(--navy);
	font-size: clamp(2.25rem, 5vw, 3.5rem);
	line-height: 1.1;
}

.description {
	margin-bottom: 1.25rem;
	color: var(--slate);
	font-size: 1.1rem;
	line-height: 1.6;
}

.article-meta {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 0.5rem;
	margin-bottom: 1.25rem;
	color: rgb(var(--gray));
	font-size: 0.85rem;
}

.separator {
	color: var(--teal);
}

.tag-list {
	display: flex;
	flex-wrap: wrap;
	gap: 0.5rem;
}

.tag {
	padding: 0.3rem 0.65rem;
	background: var(--white);
	color: var(--navy);
	border: 1px solid var(--light-gray);
	border-radius: 999px;
	font-size: 0.75rem;
	font-weight: 600;
}

.affiliate-notice {
	margin-bottom: 2rem;
	padding: 1rem 1.25rem;
	background: #eff6ff;
	border-left: 4px solid var(--blue);
	border-radius: 6px;
	color: var(--slate);
	font-size: 0.9rem;
	line-height: 1.6;
}

.affiliate-notice strong {
	color: var(--navy);
}

.affiliate-notice span {
	margin-left: 0.25rem;
}

.affiliate-notice a {
	margin-left: 0.35rem;
	font-weight: 700;
}
		</style>
	</head>

	<body>
		<Header />
		  <main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<header class="article-header">
	                  <nav class="breadcrumbs" aria-label="Breadcrumb">
						<a href={sectionUrl}>
							{sectionName}
						</a>

						<span>›</span>

						<a href={categoryUrl}>
							{displayCategory}
						</a>
					</nav>

	                  <p class="content-type">{contentTypeName}</p>

	                  <h1>{title}</h1>

	                <p class="description">{description}</p>

	               <div class="article-meta">
		              <span>By {author}</span>

		              <span class="separator">•</span>

		              <span>
			            Published <FormattedDate date={pubDate} />
		              </span>

		             {updatedDate && (
			            <>
				     <span class="separator">•</span>
				     <span>
					  Updated <FormattedDate date={updatedDate} />
				     </span>
			       </>
		        )}
	        </div>

	                 {tags.length > 0 && (
		               <div class="tag-list">
			           {tags.map((tag) => (
				       <span class="tag">{tag}</span>
			             ))}
		    </div>
	          )}
           </header>
		     {affiliate && (
	<aside class="affiliate-notice">
		<strong>Affiliate disclosure:</strong>
		<span>
			This article contains affiliate links. If you purchase through
			one of these links, The Practical Tech Guy may earn a commission
			at no additional cost to you.
		</span>
		<a href="/affiliate-disclosure/">Learn more</a>
	</aside>
)}
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

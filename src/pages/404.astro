---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const pageTitle = `Page Not Found | ${SITE_TITLE}`;

const pageDescription =
	'The page you were looking for could not be found on The Practical Tech Guy.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={pageTitle}
			description={pageDescription}
			noindex={true}
		/>
	</head>

	<body>
		<Header />

		<main class="error-page">
			<section class="error-content">
				<p class="error-code">404</p>

				<p class="eyebrow">PAGE NOT FOUND</p>

				<h1>Looks like this link needs troubleshooting.</h1>

				<p class="error-description">
					The page may have moved, the address may be incorrect,
					or the content may no longer be available.
				</p>

				<div class="error-actions">
					<a class="button primary" href="/">
						Go to Homepage
					</a>

					<a class="button secondary" href="/guides/">
						Browse Tech Guides
					</a>
				</div>
			</section>

			<section class="helpful-links">
				<h2>Looking for something else?</h2>

				<div class="link-grid">
					<a href="/guides/">
						<strong>Tech Guides</strong>
						<span>
							Troubleshooting and practical how-to articles
						</span>
					</a>

					<a href="/comparisons/">
						<strong>Comparisons</strong>
						<span>
							Side-by-side technology comparisons
						</span>
					</a>

					<a href="/reviews/">
						<strong>Reviews</strong>
						<span>
							Practical hardware, software, and service reviews
						</span>
					</a>

					<a href="/contact/">
						<strong>Contact</strong>
						<span>
							Questions, corrections, and suggestions
						</span>
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.error-page {
		width: 960px;
		max-width: calc(100% - 2em);
		padding-top: 5rem;
		padding-bottom: 5rem;
	}

	.error-content {
		max-width: 760px;
		margin-bottom: 5rem;
	}

	.error-code {
		margin: 0 0 0.25rem;
		color: var(--teal);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.error-content h1 {
		max-width: 720px;
		margin-bottom: 1.25rem;
		font-size: clamp(2.5rem, 6vw, 4rem);
		line-height: 1.05;
	}

	.error-description {
		max-width: 650px;
		margin-bottom: 2rem;
		color: var(--slate);
		font-size: 1.1rem;
	}

	.error-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.button {
		display: inline-block;
		padding: 0.8rem 1.25rem;
		border: 2px solid transparent;
		border-radius: 8px;
		font-size: 0.95rem;
		font-weight: 700;
		text-decoration: none;
	}

	.button.primary {
		background: var(--blue);
		color: var(--white);
	}

	.button.primary:hover {
		background: var(--navy);
		color: var(--white);
	}

	.button.secondary {
		background: var(--white);
		color: var(--navy);
		border-color: var(--light-gray);
	}

	.button.secondary:hover {
		color: var(--blue);
		border-color: var(--blue);
	}

	.helpful-links {
		padding-top: 3rem;
		border-top: 1px solid var(--light-gray);
	}

	.helpful-links h2 {
		margin-bottom: 1.5rem;
	}

	.link-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.link-grid a {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.5rem;
		background: var(--white);
		color: var(--slate);
		border: 1px solid var(--light-gray);
		border-radius: 12px;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.link-grid a:hover {
		color: var(--slate);
		border-color: var(--blue);
		box-shadow: 0 8px 24px rgba(15, 39, 68, 0.08);
		transform: translateY(-2px);
	}

	.link-grid strong {
		color: var(--navy);
		font-size: 1rem;
	}

	.link-grid span {
		font-size: 0.85rem;
		line-height: 1.5;
	}

	@media (max-width: 720px) {
		.error-page {
			padding-top: 3rem;
			padding-bottom: 3rem;
		}

		.error-content {
			margin-bottom: 3rem;
		}

		.error-actions {
			flex-direction: column;
		}

		.button {
			text-align: center;
		}

		.link-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const pageTitle = `About | ${SITE_TITLE}`;
const pageDescription =
	'Learn about The Practical Tech Guy and its approach to practical technology advice, troubleshooting guides, reviews, and recommendations.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>

	<body>
		<Header />

		<main>
			<h1>About The Practical Tech Guy</h1>

			<p>
				Technology should make life easier, not create another problem
				to solve.
			</p>

			<p>
				The Practical Tech Guy was created to provide straightforward,
				real-world technology advice without unnecessary jargon,
				hype, or overly complicated explanations.
			</p>

			<section>
				<h2>What You'll Find Here</h2>

				<p>
					The Practical Tech Guy focuses on practical technology
					topics including:
				</p>

				<ul>
					<li>Windows troubleshooting and configuration</li>
					<li>Computers, laptops, and accessories</li>
					<li>Microsoft 365 and productivity software</li>
					<li>Software and online services</li>
					<li>Networking and connected technology</li>
					<li>Security and backup tools</li>
					<li>AI and emerging technology</li>
					<li>Product reviews and comparisons</li>
				</ul>
			</section>

			<section>
				<h2>A Practical Approach to Technology</h2>

				<p>
					The goal isn't to cover every new gadget or repeat
					specifications from a product page. The focus is on the
					questions that matter when you're actually using
					technology:
				</p>

				<ul>
					<li>Does it solve the problem?</li>
					<li>Is it reliable?</li>
					<li>Is it easy to use?</li>
					<li>What are the drawbacks?</li>
					<li>Is there a better alternative?</li>
					<li>Is it worth the money?</li>
				</ul>
			</section>

			<section>
				<h2>Reviews & Recommendations</h2>

				<p>
					Reviews and recommendations are intended to help readers
					make informed technology decisions. Products and services
					are evaluated based on practical considerations such as
					usefulness, features, reliability, ease of use, value,
					research, and hands-on experience when applicable.
				</p>

				<p>
					Some content may contain affiliate links or involve other
					material relationships. Those relationships do not
					guarantee positive coverage and will be disclosed where
					applicable.
				</p>

				<p>
					You can learn more in the
					<a href="/affiliate-disclosure">Affiliate Disclosure</a>.
				</p>
			</section>

			<section>
				<h2>Who The Practical Tech Guy Is For</h2>

				<p>
					This site is for people who want technology explained
					clearly and practically, whether you're troubleshooting a
					Windows PC, choosing software for a small business,
					improving a home office, or deciding which piece of
					technology is actually worth buying.
				</p>
			</section>

			<section>
				<h2>Get in Touch</h2>

				<p>
					Have a question, correction, review suggestion, or
					partnership inquiry?
				</p>

				<p>
					<a href="/contact">Contact The Practical Tech Guy</a>.
				</p>
			</section>
		</main>

		<Footer />
	</body>
</html>
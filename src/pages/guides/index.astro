---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { categories, getCategoryName } from '../../data/categories';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tech Guides | ${SITE_TITLE}`} description="Practical technology guides and step-by-step troubleshooting for Windows, Microsoft 365, hardware, networking, software, security, and AI."/>
		<style>
			main {
				width: 960px;
			}
			
			.page-header {
	margin-bottom: 3rem;
}

.latest-guides {
	margin-top: 4rem;
	padding-top: 3rem;
	border-top: 1px solid var(--light-gray);
}

.latest-header {
	max-width: 680px;
	margin-bottom: 2rem;
}

.latest-header h2 {
	margin-bottom: 0.75rem;
	font-size: clamp(2rem, 4vw, 2.75rem);
}

.latest-header > p:last-child {
	margin-bottom: 0;
	color: var(--slate);
	font-size: 1rem;
	line-height: 1.7;
}

.latest-grid {
	display: grid;
	gap: 1.25rem;
}

.guide-card {
	padding: 1.75rem;
	background: var(--white);
	border: 1px solid var(--light-gray);
	border-radius: 12px;
	box-shadow: 0 4px 16px rgba(15, 39, 68, 0.06);
	transition:
		border-color 0.2s ease,
		box-shadow 0.2s ease,
		transform 0.2s ease;
}

.guide-card:hover {
	border-color: var(--blue);
	box-shadow: 0 8px 24px rgba(15, 39, 68, 0.1);
	transform: translateY(-2px);
}

.guide-category {
	margin: 0 0 0.75rem;
	color: var(--teal);
	font-size: 0.75rem;
	font-weight: 700;
	letter-spacing: 0.1em;
	text-transform: uppercase;
}

.guide-card h3 {
	margin-bottom: 0.75rem;
	font-size: 1.5rem;
	line-height: 1.3;
}

.guide-card h3 a {
	color: var(--navy);
	text-decoration: none;
}

.guide-card h3 a:hover {
	color: var(--blue);
}

.guide-description {
	margin-bottom: 1.25rem;
	color: var(--slate);
	font-size: 0.95rem;
	line-height: 1.6;
}

.guide-footer {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
	padding-top: 1rem;
	border-top: 1px solid var(--light-gray);
}

.guide-date {
	color: rgb(var(--gray));
	font-size: 0.85rem;
}

.read-guide {
	color: var(--blue);
	font-size: 0.9rem;
	font-weight: 700;
	text-decoration: none;
}

.read-guide:hover {
	text-decoration: underline;
}

.empty-guides {
	padding: 2rem;
	background: var(--white);
	border: 1px solid var(--light-gray);
	border-radius: 12px;
}

.empty-guides h3 {
	margin-bottom: 0.5rem;
}

.empty-guides p {
	margin-bottom: 0;
}

.categories {
	margin-bottom: 4rem;
}

.categories h2 {
	margin-bottom: 1.5rem;
	font-size: 1.5rem;
}

.category-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 0.75rem;
}

.category-grid a {
	display: flex;
	align-items: center;
	justify-content: center;
	min-height: 80px;
	padding: 1rem;
	background: var(--white);
	color: var(--navy);
	border: 1px solid var(--light-gray);
	border-radius: 10px;
	font-weight: 700;
	text-align: center;
	text-decoration: none;
	transition:
		color 0.2s ease,
		border-color 0.2s ease,
		box-shadow 0.2s ease,
		transform 0.2s ease;
}

.category-grid a:hover {
	color: var(--blue);
	border-color: var(--blue);
	box-shadow: 0 4px 16px rgba(15, 39, 68, 0.08);
	transform: translateY(-2px);
}

			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
				.category-grid {
	grid-template-columns: repeat(2, 1fr);
}
.guide-card {
	padding: 1.5rem;
}

.guide-footer {
	align-items: flex-start;
	flex-direction: column;
}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
		  <header class="page-header">
	<p class="eyebrow">TECH GUIDES</p>
	<h1>Practical solutions for real technology problems.</h1>
	<p>
		Step-by-step troubleshooting, how-to guides, and straightforward
		explanations for Windows, Microsoft 365, hardware, networking,
		software, security, and AI.
	</p>
</header>

<section class="categories">
	<h2>Browse by Topic</h2>

	<div class="category-grid">
	  {categories.map((category) => (
		<a href={`/guides/category/${category.slug}/`}>
			{category.name}
		</a>
	      ))}
    </div>
</section>
			<section class="latest-guides">
	<div class="latest-header">
		<p class="eyebrow">LATEST</p>
		<h2>Latest Guides</h2>
		<p>
			The newest troubleshooting guides, how-to articles, and practical
			technology advice from The Practical Tech Guy.
		</p>
	</div>

	{posts.length > 0 ? (
		<div class="latest-grid">
			{posts.map((post) => (
				<article class="guide-card">
					<p class="guide-category">
						{getCategoryName(post.data.category)}
					</p>

					<h3>
						<a href={`/guides/${post.id}/`}>
							{post.data.title}
						</a>
					</h3>

					<p class="guide-description">
						{post.data.description}
					</p>

					<div class="guide-footer">
						<span class="guide-date">
							<FormattedDate date={post.data.pubDate} />
						</span>

						<a class="read-guide" href={`/guides/${post.id}/`}>
							Read Guide →
						</a>
					</div>
				</article>
			))}
		</div>
	) : (
		<div class="empty-guides">
			<h3>New guides are on the way</h3>
			<p>
				Practical troubleshooting and technology guides will appear
				here as they're published.
			</p>
		</div>
	)}
</section>

		</main>
		<Footer />
	</body>
</html>

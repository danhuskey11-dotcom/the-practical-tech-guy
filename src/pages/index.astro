---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
	<section>
		<p>Real-world technology without the jargon.</p>

		<h1>Practical tech. Straightforward answers.</h1>

		<p>
			The Practical Tech Guy provides hands-on troubleshooting guides,
			honest technology reviews, and practical recommendations to help
			you get more out of the technology you use every day.
		</p>

		<p>
			<a href="/blog/">Explore Tech Guides</a>
		</p>
	</section>

	<section>
		<h2>What You'll Find Here</h2>

		<h3>Troubleshooting Guides</h3>
		<p>
			Step-by-step solutions for Windows, computers, software, hardware,
			networking, and the technology problems that get in your way.
		</p>

		<h3>Reviews & Recommendations</h3>
		<p>
			Practical reviews and comparisons focused on whether a product or
			service is actually worth your money.
		</p>

		<h3>Software & Productivity</h3>
		<p>
			Guides and recommendations for Microsoft 365, productivity software,
			security tools, AI, and other useful technology.
		</p>
	</section>

	<section>
		<h2>Latest Tech Guides</h2>
		<p>
			New troubleshooting guides, reviews, and practical technology
			advice are coming soon.
		</p>

		<p>
			<a href="/blog/">View All Guides</a>
		</p>
	</section>
</main>
		<Footer />
	</body>
</html>

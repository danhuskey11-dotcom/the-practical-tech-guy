---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { getCategoryName } from '../data/categories';

const featuredGuides = (await getCollection('blog'))
	.filter(
		(post) =>
			!post.data.draft &&
			post.data.featured &&
			post.data.contentType === 'guide',
	)
	.sort(
		(a, b) =>
			b.data.pubDate.valueOf() -
			a.data.pubDate.valueOf(),
	)
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
	
	<section class="hero">
	  <p class="eyebrow">THE PRACTICAL TECH GUY</p>

	  <h1>
		Practical tech.<br />
		Straightforward answers.
	  </h1>

	  <p class="hero-description">
		Real-world troubleshooting guides, honest technology reviews,
		and practical recommendations to help you get more out of the
		technology you use every day.
	  </p>

	  <div class="hero-actions">
		<a class="button primary" href="/guides">Explore Tech Guides</a>
		<a class="button secondary" href="/reviews">Browse Reviews</a>
	  </div>
    </section>


	<section class="features">
	<div class="section-heading">
		<p class="eyebrow">EXPLORE</p>
		<h2>What You'll Find Here</h2>
	</div>

	<div class="feature-grid">
		<article class="feature-card">
			<div class="card-accent"></div>
			<h3>Troubleshooting Guides</h3>
			<p>
				Step-by-step solutions for Windows, computers, software,
				hardware, networking, and the technology problems that get
				in your way.
			</p>
			<a href="/guides">Explore Tech Guides →</a>
		</article>

		<article class="feature-card">
			<div class="card-accent"></div>
			<h3>Reviews & Recommendations</h3>
			<p>
				Practical reviews and comparisons focused on whether a
				product or service is actually worth your money.
			</p>
			<a href="/reviews">Browse Reviews →</a>
		</article>

		<article class="feature-card">
			<div class="card-accent"></div>
			<h3>Software & Productivity</h3>
			<p>
				Guides and recommendations for Microsoft 365,
				productivity software, security tools, AI, and other
				useful technology.
			</p>
			<a href="/guides">Explore Software Guides →</a>
		</article>
	</div>
   </section>

<section class="latest">
	<div class="section-heading">
		<p class="eyebrow">FEATURED</p>
		<h2>Featured Tech Guides</h2>
		<p>
			Practical troubleshooting and technology guides built around
			real-world problems.
		</p>
	</div>

	{featuredGuides.length > 0 ? (
		<div class="featured-guides">
			{featuredGuides.map((post) => (
				<article class="featured-guide">
					<p class="guide-category">
						{getCategoryName(post.data.category)}
					</p>

					<h3>
						<a href={`/guides/${post.id}/`}>
							{post.data.title}
						</a>
					</h3>

					<p class="guide-description">
						{post.data.description}
					</p>

					<div class="guide-meta">
						<span>
							<FormattedDate date={post.data.pubDate} />
						</span>

						<a href={`/guides/${post.id}/`}>
							Read Guide →
						</a>
					</div>
				</article>
			))}
		</div>
	) : (
		<div class="empty-featured">
			<h3>New guides are on the way</h3>
			<p>
				Practical troubleshooting and technology guides will appear
				here as they're published.
			</p>
		</div>
	)}

	<div class="view-all-guides">
		<a class="button secondary" href="/guides/">
			View All Tech Guides
		</a>
	</div>
</section>

</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 4rem 0 5rem;
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: var(--teal);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.hero h1 {
		max-width: 700px;
		margin-bottom: 1.25rem;
		color: var(--navy);
		font-size: clamp(2.75rem, 7vw, 4.5rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
	}

	.hero-description {
		max-width: 650px;
		margin-bottom: 2rem;
		color: var(--slate);
		font-size: 1.15rem;
		line-height: 1.7;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.button {
		display: inline-block;
		padding: 0.8rem 1.25rem;
		border: 2px solid transparent;
		border-radius: 8px;
		font-size: 0.95rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease;
	}

	.button:hover {
		transform: translateY(-1px);
	}

	.button.primary {
		background: var(--blue);
		color: var(--white);
	}

	.button.primary:hover {
		background: var(--navy);
		color: var(--white);
	}

	.button.secondary {
		background: transparent;
		color: var(--navy);
		border-color: var(--light-gray);
	}

	.button.secondary:hover {
		color: var(--blue);
		border-color: var(--blue);
	}

	.features {
	padding: 1rem 0 5rem;
}

.section-heading {
	margin-bottom: 2rem;
}

.section-heading h2 {
	margin: 0;
	color: var(--navy);
	font-size: clamp(2rem, 4vw, 2.75rem);
}

.feature-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 1.25rem;
}

.feature-card {
	position: relative;
	display: flex;
	flex-direction: column;
	padding: 1.75rem;
	overflow: hidden;
	background: var(--white);
	border: 1px solid var(--light-gray);
	border-radius: 12px;
	box-shadow: 0 4px 16px rgba(15, 39, 68, 0.06);
}

.card-accent {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 4px;
	background: var(--teal);
}

.feature-card h3 {
	margin: 0 0 0.75rem;
	color: var(--navy);
	font-size: 1.25rem;
}

.feature-card p {
	flex-grow: 1;
	margin: 0 0 1.25rem;
	color: var(--slate);
	font-size: 0.95rem;
	line-height: 1.6;
}

.feature-card a {
	color: var(--blue);
	font-size: 0.9rem;
	font-weight: 700;
	text-decoration: none;
}

.feature-card a:hover {
	text-decoration: underline;
}

.latest {
	padding: 1rem 0 4rem;
}

.latest .section-heading {
	max-width: 650px;
}

.latest .section-heading > p:last-child {
	color: var(--slate);
	font-size: 1rem;
	line-height: 1.7;
}

.featured-guides {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 1.25rem;
	margin-top: 2rem;
}

.featured-guide {
	display: flex;
	flex-direction: column;
	padding: 1.75rem;
	background: var(--white);
	border: 1px solid var(--light-gray);
	border-radius: 12px;
	box-shadow: 0 4px 16px rgba(15, 39, 68, 0.06);
}

.guide-category {
	margin: 0 0 0.75rem;
	color: var(--teal);
	font-size: 0.75rem;
	font-weight: 700;
	letter-spacing: 0.1em;
	text-transform: uppercase;
}

.featured-guide h3 {
	margin-bottom: 0.75rem;
	font-size: 1.25rem;
	line-height: 1.3;
}

.featured-guide h3 a {
	color: var(--navy);
	text-decoration: none;
}

.featured-guide h3 a:hover {
	color: var(--blue);
}

.guide-description {
	flex-grow: 1;
	margin-bottom: 1.25rem;
	color: var(--slate);
	font-size: 0.95rem;
	line-height: 1.6;
}

.guide-meta {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
	padding-top: 1rem;
	border-top: 1px solid var(--light-gray);
	font-size: 0.8rem;
}

.guide-meta span {
	color: rgb(var(--gray));
}

.guide-meta a {
	color: var(--blue);
	font-weight: 700;
	text-decoration: none;
}

.guide-meta a:hover {
	text-decoration: underline;
}

.empty-featured {
	margin-top: 2rem;
	padding: 2rem;
	background: var(--white);
	border: 1px solid var(--light-gray);
	border-radius: 12px;
}

.empty-featured h3 {
	margin-bottom: 0.5rem;
}

.empty-featured p {
	margin-bottom: 0;
}

.view-all-guides {
	margin-top: 1.5rem;
}

@media (max-width: 720px) {
		.hero {
			padding: 2.5rem 0 3.5rem;
		}

		.hero-description {
			font-size: 1rem;
		}

		.hero-actions {
			flex-direction: column;
		}

		.button {
			text-align: center;
		}

		.feature-grid {
			grid-template-columns: 1fr;
		}

		.features {
			padding-bottom: 3rem;
		}

		.feature-card {
			padding: 1.5rem;
		}

		.featured-guides {
	grid-template-columns: 1fr;
}

.guide-meta {
	align-items: flex-start;
	flex-direction: column;
}
	}
</style>

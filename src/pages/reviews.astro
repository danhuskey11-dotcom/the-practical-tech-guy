---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const pageTitle = `Reviews & Recommendations | ${SITE_TITLE}`;
const pageDescription =
	'Practical technology reviews, comparisons, and recommendations focused on helping you choose products and software that are actually worth your money.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>

	<body>
		<Header />

		<main>
			<h1>Reviews & Recommendations</h1>

			<p>
				Honest, practical reviews and comparisons of technology,
				software, and services designed to help you decide what's
				actually worth your money.
			</p>

			<section>
				<h2>Software</h2>
				<p>
					Reviews and comparisons of productivity tools, security
					software, cloud services, AI tools, and other software
					I've tested or researched.
				</p>
			</section>

			<section>
				<h2>Hardware</h2>
				<p>
					Practical recommendations for computers, monitors,
					docking stations, webcams, networking equipment, storage,
					and other technology.
				</p>
			</section>

			<section>
				<h2>Comparisons</h2>
				<p>
					Side-by-side comparisons that focus on the differences
					that actually matter when deciding which product or
					service to buy.
				</p>
			</section>

			<section>
				<h2>Latest Reviews</h2>
				<p>Reviews and recommendations are coming soon.</p>
			</section>
		</main>

		<Footer />
	</body>
</html>
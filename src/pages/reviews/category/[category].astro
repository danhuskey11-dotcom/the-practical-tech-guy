---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';
import {
	reviewCategories,
	getReviewCategoryName,
	getReviewCategoryDescription,
} from '../../../data/reviewCategories';

export function getStaticPaths() {
	return reviewCategories.map((category) => ({
		params: {
			category: category.slug,
		},
		props: {
			category: category.slug,
		},
	}));
}

const { category } = Astro.props;

const categoryName = getReviewCategoryName(category);
const categoryDescription =
	getReviewCategoryDescription(category);

const reviews = (await getCollection('blog'))
	.filter(
		(post) =>
			!post.data.draft &&
			post.data.contentType === 'review' &&
			post.data.reviewCategory === category,
	)
	.sort(
		(a, b) =>
			b.data.pubDate.valueOf() -
			a.data.pubDate.valueOf(),
	);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${categoryName} Reviews | ${SITE_TITLE}`}
			description={`${categoryDescription}`}
			noindex={reviews.length === 0}
		/>
	</head>

	<body>
		<Header />

		<main>
			<header class="page-header">
				<nav class="breadcrumbs" aria-label="Breadcrumb">
					<a href="/reviews/">Reviews</a>
					<span>›</span>
					<span aria-current="page">
						{categoryName}
					</span>
				</nav>

				<p class="eyebrow">REVIEWS</p>

				<h1>{categoryName}</h1>

				<p class="category-description">
					{categoryDescription}
				</p>
			</header>

			<section class="review-list">
				<div class="section-header">
					<h2>Latest {categoryName} Reviews</h2>
				</div>

				{reviews.length > 0 ? (
					<div class="review-grid">
						{reviews.map((review) => (
							<article class="review-card">
								<p class="review-label">
									{categoryName}
								</p>

								<h3>
									<a href={`/reviews/${review.id}/`}>
										{review.data.title}
									</a>
								</h3>

								<p class="review-description">
									{review.data.description}
								</p>

								<div class="review-footer">
									<span>
										<FormattedDate
											date={review.data.pubDate}
										/>
									</span>

									<a
										class="read-review"
										href={`/reviews/${review.id}/`}
									>
										Read Review →
									</a>
								</div>
							</article>
						))}
					</div>
				) : (
					<div class="empty-state">
						<h3>
							{categoryName} reviews are coming soon
						</h3>

						<p>
							New {categoryName.toLowerCase()} reviews and
							recommendations will appear here as they're
							published.
						</p>

						<a href="/reviews/">
							Browse all review categories →
						</a>
					</div>
				)}
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
		max-width: calc(100% - 2em);
	}

	.page-header {
		margin-bottom: 4rem;
	}

	.breadcrumbs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1.5rem;
		font-size: 0.85rem;
	}

	.breadcrumbs a {
		color: var(--blue);
		font-weight: 600;
		text-decoration: none;
	}

	.breadcrumbs a:hover {
		text-decoration: underline;
	}

	.breadcrumbs span {
		color: rgb(var(--gray));
	}

	.category-description {
		max-width: 760px;
		color: var(--slate);
	}

	.review-list {
		padding-top: 3rem;
		border-top: 1px solid var(--light-gray);
	}

	.section-header {
		margin-bottom: 2rem;
	}

	.section-header h2 {
		margin-bottom: 0;
	}

	.review-grid {
		display: grid;
		gap: 1.25rem;
	}

	.review-card {
		padding: 1.75rem;
		background: var(--white);
		border: 1px solid var(--light-gray);
		border-radius: 12px;
		box-shadow: 0 4px 16px rgba(15, 39, 68, 0.06);
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.review-card:hover {
		border-color: var(--blue);
		box-shadow: 0 8px 24px rgba(15, 39, 68, 0.1);
		transform: translateY(-2px);
	}

	.review-label {
		margin: 0 0 0.75rem;
		color: var(--teal);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.review-card h3 {
		margin-bottom: 0.75rem;
		font-size: 1.5rem;
		line-height: 1.3;
	}

	.review-card h3 a {
		color: var(--navy);
		text-decoration: none;
	}

	.review-card h3 a:hover {
		color: var(--blue);
	}

	.review-description {
		color: var(--slate);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.review-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--light-gray);
	}

	.review-footer span {
		color: rgb(var(--gray));
		font-size: 0.85rem;
	}

	.read-review,
	.empty-state a {
		color: var(--blue);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
	}

	.read-review:hover,
	.empty-state a:hover {
		text-decoration: underline;
	}

	.empty-state {
		padding: 2rem;
		background: var(--white);
		border: 1px solid var(--light-gray);
		border-radius: 12px;
	}

	.empty-state h3 {
		margin-bottom: 0.5rem;
	}

	.empty-state p {
		margin-bottom: 1rem;
	}

	@media (max-width: 720px) {
		.review-card {
			padding: 1.5rem;
		}

		.review-footer {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
